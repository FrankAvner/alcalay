# Main
# ---------------------------------------------------------------------------

def main() -> int:

    account = DEFAULT_ACCOUNT

    if len(sys.argv) > 1:

        argument = (
            sys.argv[1]
            .strip()
        )

        if argument:
            account = argument

    copier = GmailCopy(
        account_email=account
    )

    try:

        success = copier.run()

        return 0 if success else 1

    except KeyboardInterrupt:

        print()
        print()
        print(
            "[CANCELLED] User interrupted the operation."
        )
        print()

        return 130

    except Exception as exc:

        print()
        print(
            "=" * 72
        )
        print(
            "FATAL ERROR"
        )
        print(
            "=" * 72
        )
        print()

        print(
            str(exc)
        )

        print()

        return 1




if __name__ == "__main__":
    raise SystemExit(
        main()
    )