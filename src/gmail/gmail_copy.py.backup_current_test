    def copy_selected_labels(
        self,
    ) -> bool:

        print()
        print(
            "=" * 72
        )
        print(
            "STARTING COPY"
        )
        print(
            "=" * 72
        )
        print()

        print(
            "The following labels will be copied:"
        )

        print()

        for label in self.selected_labels:

            count = label.get(
                "gmail_count"
            )

            if count is None:
                count_text = "unknown"
            else:
                count_text = (
                    f"{count:,}"
                )

