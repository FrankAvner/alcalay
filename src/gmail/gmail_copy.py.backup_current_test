        cursor = None

        try:

            connection = (
                self.get_database_connection()
            )

            sql = """
                UPDATE gmail_import_runs
                SET
                    messages_found = %s,
                    messages_already_exists = %s,
                    messages_downloaded = %s,
                    messages_failed = %s,
                    history_end = %s,
                    finished_at = %s,
