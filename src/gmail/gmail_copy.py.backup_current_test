    # -----------------------------------------------------------------------
    # COUNT
    # -----------------------------------------------------------------------

    def count_label_messages(
        self,
        label_id: str,
    ) -> tuple[int, str | None]:

        if self.service is None:
            raise RuntimeError(
                "Gmail service is not connected."
            )

        total = 0
        page_token = None

        while True:

            kwargs = {
                "userId": "me",
                "labelIds": [
                    label_id
                ],
                "maxResults": (
                    GMAIL_PAGE_SIZE
                ),
            }

            if page_token:
                kwargs[
                    "pageToken"
                ] = page_token

            response = (
                self.execute_with_retry(
                    self.service.users()
                    .messages()
                    .list(
                        **kwargs
                    ),
                    f"count label {label_id}",
                )
            )

            messages = response.get(
                "messages",
                [],
            )

            total += len(
                messages
            )

            page_token = response.get(
                "nextPageToken"
            )

            if not page_token:
                break

        history_id = (
            self.get_current_history_id()
        )

        return (
            total,
            history_id,
        )

